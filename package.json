{
  "name": "vagudle",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run check:words && vite build && node scripts/optimize-dist.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && react-doctor --verbose",
    "check:overrides": "node scripts/check-unused-overrides.mjs",
    "check:words": "node scripts/check-word-lists.mjs",
    "doctor": "pnpm dlx react-doctor@latest --verbose",
    "doctor:report": "node scripts/doctor-report.mjs",
    "format": "svgo -f src -r && svgo -f public -r && prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"functions/**/*.{js,json}\" \"workers/**/*.{js,json,md,html}\" \"workers/**/pnpm-workspace.yaml\" \"*.{html,json,js,cjs,md,ts}\" \"public/**/*.{html,json,xml,md}\" \"docs/**/*.{html,css,js}\" \".github/**/*.md\" \".github/workflows/*.yml\" \"scripts/*.mjs\" \"pnpm-workspace.yaml\" \"migrations/*.sql\" \"*.toml\" \"workers/**/*.toml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"functions/**/*.{js,json}\" \"workers/**/*.{js,json,md,html}\" \"workers/**/pnpm-workspace.yaml\" \"*.{html,json,js,cjs,md,ts}\" \"public/**/*.{html,json,xml,md}\" \"docs/**/*.{html,css,js}\" \".github/**/*.md\" \".github/workflows/*.yml\" \"scripts/*.mjs\" \"pnpm-workspace.yaml\" \"migrations/*.sql\" \"*.toml\" \"workers/**/*.toml\"",
    "largest-files": "node scripts/largest-files.mjs",
    "lint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "start": "vite",
    "start:backend": "pnpm run build && pnpm exec wrangler pages dev --proxy 5173",
    "typecheck": "pnpm run types && node ./node_modules/typescript-7/bin/tsc --noEmit && node ./node_modules/typescript-7/bin/tsc --noEmit -p functions/tsconfig.json",
    "types": "wrangler types"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "classnames": "^2.5.1",
    "exiftool-vendored": "^37.2.0",
    "ffmpeg-static": "5.3.0",
    "firebase": "^12.19.0",
    "framer-motion": "^12.43.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.53.0",
    "marked": "^18.1.0",
    "marked-gfm-heading-id": "^4.1.4",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "twemoji": "^14.0.2",
    "ua-parser-js": "^2.0.10",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0",
    "webgl-fluid-enhanced": "^0.8.0",
    "zero-md": "^3.1.9"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-toml": "^2.0.6",
    "react-doctor": "^0.9.17",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.149.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,css,md}": "prettier --write",
    "src/**/*.svg": "svgo",
    "functions/**/*.js": "prettier --write",
    "workers/**/*.{js,json,md}": "prettier --write",
    "*.{html,json,js,cjs,md}": "prettier --write",
    "public/**/*.{html,json}": "prettier --write",
    "docs/**/*.{html,css,js}": "prettier --write",
    "public/**/*.svg": "svgo",
    ".github/**/*.md": "prettier --write"
  },
  "packageManager": "pnpm@12.10.1"
}
