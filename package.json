{
  "name": "vagudle",
  "version": "1.4.6",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:backend": "pnpm run build && pnpm exec wrangler pages dev --proxy 5173",
    "build": "vite build && node scripts/optimize-dist.mjs",
    "types": "wrangler types",
    "typecheck": "pnpm run types && node ./node_modules/typescript-7/bin/tsc --noEmit && node ./node_modules/typescript-7/bin/tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "format": "svgo -f src -r && svgo -f public -r && prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"functions/**/*.js\" \"workers/**/*.{js,json,md}\" \"*.{html,json,js,cjs,md}\" \"public/**/*.{html,json}\" \".github/**/*.md\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"functions/**/*.js\" \"workers/**/*.{js,json,md}\" \"*.{html,json,js,cjs,md}\" \"public/**/*.{html,json}\" \".github/**/*.md\" \"scripts/*.mjs\"",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && react-doctor --verbose",
    "doctor": "pnpm dlx react-doctor@latest --verbose",
    "doctor:report": "node scripts/doctor-report.mjs",
    "check:overrides": "node scripts/check-unused-overrides.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "classnames": "^2.5.1",
    "exiftool-vendored": "^37.2.0",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.17.1",
    "framer-motion": "^12.43.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.31.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "twemoji": "^14.0.2",
    "ua-parser-js": "^2.0.10",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "webgl-fluid-enhanced": "^0.8.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.12",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.124.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,css,md}": "prettier --write",
    "src/**/*.svg": "svgo",
    "functions/**/*.js": "prettier --write",
    "workers/**/*.{js,json,md}": "prettier --write",
    "*.{html,json,js,cjs,md}": "prettier --write",
    "public/**/*.{html,json}": "prettier --write",
    "public/**/*.svg": "svgo",
    ".github/**/*.md": "prettier --write"
  },
  "packageManager": "pnpm@11.22.0"
}
