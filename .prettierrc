{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "plugins": ["@prettier/plugin-xml", "prettier-plugin-sql", "prettier-plugin-toml"],
  "language": "sqlite",
  "keywordCase": "upper"
}
